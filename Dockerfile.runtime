FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORTFOLIO_CONFIG=/app/config/config.py

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ffmpeg gosu nginx poppler-utils supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

COPY backend/requirements.txt /tmp/portfolio-requirements.txt
RUN pip install --no-cache-dir -r /tmp/portfolio-requirements.txt \
    && rm /tmp/portfolio-requirements.txt

COPY deploy/nginx/unified.conf /etc/nginx/conf.d/default.conf
COPY deploy/supervisor/portfolio.conf /etc/supervisor/conf.d/portfolio.conf
COPY deploy/runtime-entrypoint.sh /app/runtime-entrypoint.sh

RUN addgroup --system portfolio \
    && adduser --system --ingroup portfolio --home /app portfolio \
    && mkdir -p /app/backend /app/data /app/uploads /app/config /usr/share/nginx/html /run/nginx \
    && chmod +x /app/runtime-entrypoint.sh \
    && chown -R portfolio:portfolio /app/data /app/uploads

EXPOSE 80
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=35s --retries=3 \
  CMD curl -fsS http://127.0.0.1/api/health || exit 1

ENTRYPOINT ["/app/runtime-entrypoint.sh"]
