FROM node:26-alpine AS frontend-builder

WORKDIR /frontend
COPY frontend/package*.json ./
RUN corepack enable \
    && yarn dlx cnpm@latest install
COPY frontend/ .
RUN ./node_modules/.bin/vue-tsc --noEmit \
    && ./node_modules/.bin/vite build


FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORTFOLIO_CONFIG=/app/config/config.container.py

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        ffmpeg \
        gosu \
        nginx \
        poppler-utils \
        supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

WORKDIR /app/backend
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .
COPY deploy/config/config.container.py /app/config/config.container.py
COPY deploy/nginx/unified.conf /etc/nginx/conf.d/default.conf
COPY deploy/supervisor/portfolio.conf /etc/supervisor/conf.d/portfolio.conf
COPY deploy/unified-entrypoint.sh /app/unified-entrypoint.sh
COPY --from=frontend-builder /frontend/dist /usr/share/nginx/html

RUN addgroup --system portfolio \
    && adduser --system --ingroup portfolio --home /app portfolio \
    && mkdir -p /app/data /app/uploads /app/config /run/nginx \
    && chmod +x /app/unified-entrypoint.sh \
    && chown -R portfolio:portfolio /app/backend /app/data /app/uploads

EXPOSE 80
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD curl -fsS http://127.0.0.1/api/health || exit 1

ENTRYPOINT ["/app/unified-entrypoint.sh"]
